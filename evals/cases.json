        "Read",
        "Grep",
        "Glob",
        "Bash(git diff:*)",
        "Bash(git status:*)",
        "Bash(git log:*)"
      ],
      "must": [
        "APPROVE"
      ],
      "must_not": [
        "\\[(Critical|High)\\]",
        "Verdict[^\\n]*\\n+[^\\n]*\\*\\*BLOCK"
      ],
      "unchanged": true,
      "max_turns": 15
