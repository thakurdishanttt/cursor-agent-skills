{
  "_comment": "Each case runs Claude Code headless in a temp copy of its fixture with ALL skills installed, so skill selection is tested too. 'base' is committed first; 'change' (if any) is applied on top as the diff to review. 'skill' is the skill that must be used (null = none). Patterns are case-insensitive regexes on the final answer.",
  "cases": [
    {
      "id": "review-finds-planted-vulns",
      "skill": "secure-code-review",
      "fixture": "flask-vuln",
      "prompt": "review my changes",
      "tools": [
        "Read",
        "Grep",
        "Glob",
        "Bash(git diff:*)",
        "Bash(git status:*)",
        "Bash(git log:*)"
      ],
      "must": [
        "BLOCK",
        "SQL",
        "(command|shell)[ -]injection|shell=True",
        "travers"
      ],
      "must_not": [
        "\\bAPPROVE\\b\\s*$"
      ],
      "unchanged": true,
      "max_turns": 15
    },
    {
      "id": "review-no-false-positive",
      "skill": "secure-code-review",
      "fixture": "util-clean",
      "prompt": "review my changes before I merge",
