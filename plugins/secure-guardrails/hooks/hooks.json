{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      { "command": "python3 ./scripts/guard.py prompt", "timeout": 10 }
    ],
    "beforeReadFile": [
      { "command": "python3 ./scripts/guard.py read", "timeout": 10 }
    ],
    "beforeShellExecution": [
      { "command": "python3 ./scripts/guard.py shell", "timeout": 10 }
    ],
    "beforeMCPExecution": [
      { "command": "python3 ./scripts/guard.py mcp", "timeout": 10 }
    ]
  }
}
